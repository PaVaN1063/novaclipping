# Login for the dashboard and Studio
NOVA_USER=pavan
NOVA_PASSWORD=change-me

# Long random text used to sign the login cookie
AUTH_SECRET=change-this-to-a-long-random-string

# "Quick access" button on the login page (no password).
# Always on in local dev; set to true to allow it on the live site too.
NOVA_QUICK_ACCESS=false

# Address of the Studio (clipping tool) server once it runs on the Oracle VM
STUDIO_API_URL=
